NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Setup scripts only. Never prefix an access or service key with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=your-scoped-management-token
# ACCESS_TOKEN is also supported for existing configurations.
ADMIN_EMAIL=owner@example.com
# Optional when hosted behind a reverse proxy:
APP_URL=https://your-shop.example
